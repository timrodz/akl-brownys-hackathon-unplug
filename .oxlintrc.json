{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "react"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.2"
    }
  },
  "ignorePatterns": [
    ".next/**",
    "out/**",
    "node_modules/**",
    "dist/**",
    "build/**",
    "*.tsbuildinfo"
  ],
  "rules": {},
  "overrides": [
    {
      "files": ["scripts/check-submission-flow.cjs"],
      "rules": {
        "unicorn/no-thenable": "off"
      }
    }
  ]
}
