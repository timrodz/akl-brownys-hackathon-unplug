# Local Postgres (docker compose up -d db) — copy to .env.local
DATABASE_URL=postgresql://easyre:easyre@localhost:5432/easyre

# Gemini via @ai-sdk/google — lib/ai.ts
GEMINI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=

GOOGLE_MAPS_API_KEY=

# Optional model override (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash
